# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit ขึ้น git)

# ------------------------------------------------------------------
# ฐานข้อมูล PostgreSQL จาก Neon
# วิธีหา: neon.tech -> เลือกโปรเจกต์ -> Connect -> คัดลอก connection string
# ต้องมี ?sslmode=require ต่อท้ายเสมอ
# ------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ------------------------------------------------------------------
# รหัสผ่านของบัญชี ADMIN คนแรก (ใช้ตอนรัน npm run db:seed)
# เปลี่ยนรหัสผ่านทันทีหลัง login ครั้งแรก
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.ac.th"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------
# กุญแจเข้ารหัส session ของระบบ Login (จะใช้ใน Phase 3)
# สร้างค่าสุ่มด้วยคำสั่ง: npx auth secret
# ------------------------------------------------------------------
AUTH_SECRET=""

# ที่เก็บไฟล์แนบ
UPLOAD_DIR="./uploads"
